// meshlab probe: a mesh stage shaped as the game's (32 threads, 126 vertices and 126 triangles, OUTPUTS vec4 attributes a
// vertex, each thread writing vertices other threads also index), with SHARED_WORDS words of workgroup memory used as the
// translator uses its stage buffer. Built in two sizes: with the workgroup memory RADV keeps the outputs in its mesh scratch
// ring (more than 30 KB of NGG LDS), without it they fit LDS. Reads nothing: the triangles are small and fixed.
#version 460
#extension GL_EXT_mesh_shader : require
#ifndef OUTPUTS
#define OUTPUTS 8
#endif
#ifndef SHARED_WORDS
#define SHARED_WORDS 2688
#endif
layout(local_size_x = 32) in;
layout(max_vertices = 126, max_primitives = 126, triangles) out;
layout(location = 2) out vec4 attr[126][OUTPUTS];
#if SHARED_WORDS > 0
shared uint stage[SHARED_WORDS];
#endif
void main() {
    const uint lane = gl_LocalInvocationIndex, wg = gl_WorkGroupID.x;
#if SHARED_WORDS > 0
    for (uint i = lane; i < SHARED_WORDS; i += 32u) stage[i] = i * 7u + wg;
    barrier();
#endif
    SetMeshOutputsEXT(126u, 42u);
    for (uint v = lane; v < 126u; v += 32u) {
        const float x = float(v % 14u) / 14.0 - 0.5, y = float(v / 14u) / 9.0 - 0.5;
        gl_MeshVerticesEXT[v].gl_Position = vec4(x * 0.1 + float(wg % 16u) * 0.12 - 0.9, y * 0.1 + float(wg / 16u % 16u) * 0.12 - 0.9, 0.5, 1.0);
        for (uint a = 0u; a < OUTPUTS; a++) {
#if SHARED_WORDS > 0
            const float s = float(stage[(v * OUTPUTS + a) % SHARED_WORDS]);
#else
            const float s = float(v * OUTPUTS + a);
#endif
            attr[v][a] = vec4(s, float(a), float(v), 1.0);
        }
    }
    for (uint p = lane; p < 42u; p += 32u) gl_PrimitiveTriangleIndicesEXT[p] = uvec3(3u * p, 3u * p + 1u, 3u * p + 2u);
}
