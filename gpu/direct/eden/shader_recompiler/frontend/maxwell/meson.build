# The translator's Maxwell front end: decoding and control flow; the instructions are in translate/impl.
eden_sources += files(
  'control_flow.cpp',
  'decode.cpp',
  'indirect_branch_table_track.cpp',
  'opcodes.cpp',
  'structured_control_flow.cpp',
)
subdir('translate/impl')
eden_sources += files(
  'translate/translate.cpp',
  'translate_program.cpp',
)
