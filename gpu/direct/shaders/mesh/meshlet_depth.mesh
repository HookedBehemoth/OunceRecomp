// The game's position-only meshlet stage, rewritten (mesh stages 26fa8419a38c6a41, 6942222ec7d54fe9, ef1f1c50d829bf4e; their
// task stage 2c56dc1006942f74 culls meshlets and hands each mesh workgroup one meshlet id). Used by the depth-only draws:
// occlusion proxies in the main view and shadow-map casters. A transcription of the game's logic (its data layout and
// arithmetic); our own text. docs/direct/m6e-report.md has the inventory this comes from.
//
// One workgroup draws one meshlet of a model. The model's buffer (a storage buffer of the mesh stage, slot MODEL_SLOT of the
// driver bank's table) holds, at byte 0, the dequantisation origin (3 floats) and scale (a float at 12) and the model's
// format flags (16); from byte 84 the meshlet records, and after them each meshlet's packed data: a vertex stream (positions
// quantised to 21-bit integers, each component in its own bit width) and an index stream (three vertex numbers a
// triangle, each just wide enough for the meshlet's vertex count). Positions go through the model matrix (c4) and the view
// and projection (c3).
//
// Build: glslangValidator -V --target-env vulkan1.3 -DMODEL_SLOT=<n> (26fa: 2; 6942, ef1f: 0)
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

#ifndef MODEL_SLOT
#define MODEL_SLOT 0
#endif

layout(local_size_x = 32) in;
layout(max_vertices = 126, max_primitives = 126, triangles) out;

// (the translator's bindings for this stage: c0 the driver bank, c3 the view, c4 the object)
layout(set = 0, binding = 0, scalar) uniform DriverBank { uint w[16384]; } c0;
layout(set = 0, binding = 1, scalar) uniform View { float f[16384]; } c3;
layout(set = 0, binding = 2, scalar) uniform Object { float f[16384]; } c4;

// ---- the model's buffer ----
uint model_guest_lo() { return c0.w[(0x770u + 16u * MODEL_SLOT) / 4u]; }
uint64_t model_base() {
    const uint64_t g = uint64_t(c0.w[(0x770u + 16u * MODEL_SLOT) / 4u]) | uint64_t(c0.w[(0x774u + 16u * MODEL_SLOT) / 4u]) << 32;
    return device_address(g);
}
// The word at a byte offset of the model's buffer (as NVN addresses it: from the bound address, 4-byte words)
uint model_word(uint64_t base, uint offset) {
    const uint lo = model_guest_lo();
    return Words(base + uint64_t(((lo + offset) - (lo & ~3u)) & ~3u)).w[0];
}
const uint kRecords = 84u;   // (the meshlet records' and the streams' start in the model's buffer)

// ---- one meshlet's record ----
struct Meshlet {
    uint vertices, primitives;   // (counts)
    uint data_bit;               // (its streams' first bit, from kRecords)
    uint vertex_bits;            // (bits a vertex: the three component widths)
    uint x_bits, y_bits, z_bits;
    uvec3 base;                  // (the quantised position origin, 21 bits a component)
    uint index_bits;             // (bits a vertex number: enough for vertices - 1)
};
Meshlet read_meshlet(uint64_t m, uint id) {
    const uint flags = model_word(m, 16u);
    // (a record is 4 quadwords plus one for each optional stream the model's flags name)
    const uint record_bytes = 8u * (4u + bitCount(flags & 0xc00u) + bitCount(flags & 0x1f000u));
    const uint r = kRecords + id * record_bytes;
    const uint w0 = model_word(m, r), w1 = model_word(m, r + 4u), w4 = model_word(m, r + 16u), w5 = model_word(m, r + 20u);
    const uint w6 = model_word(m, r + 24u);
    Meshlet s;
    s.primitives = bitfieldExtract(w4, 16, 8);
    s.vertices = bitfieldExtract(w4, 24, 8);
    s.data_bit = (w5 >> 4) * 8u;
    s.vertex_bits = w6 & 1023u;
    s.x_bits = bitfieldExtract(w6, 16, 5), s.y_bits = bitfieldExtract(w6, 21, 5), s.z_bits = bitfieldExtract(w6, 26, 5);
    s.base = uvec3(w0 & 0x1fffffu, ((w0 >> 21) | (w1 << 11)) & 0x1fffffu, (w1 >> 10) & 0x1fffffu);
    s.index_bits = uint(findMSB(s.vertices - 1u) + 1);   // (findMSB(0) is -1: a meshlet of one vertex has 0-bit numbers)
    return s;
}

// ---- the vertex stream: a vertex's position in the model's space ----
vec3 read_position(uint64_t m, Meshlet s, uint v) {
    const uint bit = s.data_bit + v * s.vertex_bits;
    const uint at = kRecords + (bit >> 5) * 4u;
    const uint w0 = model_word(m, at), w1 = model_word(m, at + 4u), w2 = model_word(m, at + 8u);
    const uint first = bit & 31u;
    const uvec3 q = uvec3(stream_bits(w0, w1, w2, first, s.x_bits), stream_bits(w0, w1, w2, first + s.x_bits, s.y_bits),
                          stream_bits(w0, w1, w2, first + s.x_bits + s.y_bits, s.z_bits));
    const float scale = uintBitsToFloat(model_word(m, 12u));
    const vec3 origin = vec3(uintBitsToFloat(model_word(m, 0u)), uintBitsToFloat(model_word(m, 4u)), uintBitsToFloat(model_word(m, 8u)));
    return fma(vec3(q + s.base), vec3(scale), origin);
}

// ---- the transforms (each row as the game computes it: y first, then fused x and z, then the translation) ----
// A row of a 3x4 or 4x4 matrix at float index i applied to p
float row_c4(uint i, vec3 p) { precise float y = p.y * c4.f[i + 1u]; return fma(p.z, c4.f[i + 2u], fma(p.x, c4.f[i], y)) + c4.f[i + 3u]; }
float row_c3(uint i, vec3 p) { precise float y = p.y * c3.f[i + 1u]; return fma(p.z, c3.f[i + 2u], fma(p.x, c3.f[i], y)); }
vec4 clip_position(vec3 model) {
    // (object to world: c4's 3x4 rows at floats 0, 4, 8)
    const vec3 world = vec3(row_c4(0u, model), row_c4(4u, model), row_c4(8u, model));
    // (world to view: c3's 3x4 rows at floats 0, 4, 8, applied to world + the object's offset c4[16..18], the offset's part
    // computed on its own as the game does)
    const vec3 offset = vec3(c4.f[16], c4.f[17], c4.f[18]);
    precise vec3 view;
    for (uint r = 0u; r < 3u; r++) view[r] = (row_c3(4u * r, offset) + c3.f[4u * r + 3u]) + row_c3(4u * r, world);
    // (view to clip: c3's 4x4 rows at floats 28, 32, 36, 40)
    precise vec4 clip;
    for (uint r = 0u; r < 4u; r++) clip[r] = row_c3(28u + 4u * r, view) + c3.f[31u + 4u * r];
    return clip;
}

void main() {
    const TaskInput task = task_input();
    const uint id = payload_word(task, 4u + task.index, 64u);   // (the task stage's kept meshlets, from payload word 4)
    const uint64_t m = model_base();
    const Meshlet s = read_meshlet(m, id);

    // (the game writes at most 64 vertices and 128 triangles a meshlet: 2 vertices and 4 triangles a thread)
    const uint vertices = min(s.vertices, 64u), primitives = min(s.primitives, 126u);
    SetMeshOutputsEXT(126u, primitives);
    const uint lane = gl_LocalInvocationIndex;
    for (uint k = 0u; k < 2u; k++) {
        const uint v = lane + 32u * k;
        gl_MeshVerticesEXT[v].gl_Position = vulkan_clip(v < vertices ? clip_position(read_position(m, s, v)) : vec4(0.0));
    }
    for (uint v = 64u + lane; v < 126u; v += 32u) gl_MeshVerticesEXT[v].gl_Position = vec4(0.0);   // (never written by the game)

    // ---- the index stream: three vertex numbers a triangle, after the vertex stream ----
    const uint index_start = s.data_bit + s.vertices * s.vertex_bits;
    const uint mask = (1u << min(s.index_bits, 8u)) - 1u;   // (the game keeps 8 bits of each)
    for (uint k = 0u; k < 4u; k++) {
        const uint p = lane + 32u * k;
        if (p >= primitives) continue;
        const uint bit = index_start + p * 3u * s.index_bits;
        const uint at = kRecords + (bit >> 5) * 4u;
        const uint64_t pair = uint64_t(model_word(m, at)) | uint64_t(model_word(m, at + 4u)) << 32;
        uvec3 corner;
        for (uint j = 0u; j < 3u; j++) corner[j] = min(uint(pair >> min((bit & 31u) + j * s.index_bits, 63u)) & mask, 125u);
        gl_PrimitiveTriangleIndicesEXT[p] = corner;
    }
}
